{
  "name": "@livingdesign/icons",
  "version": "0.4.53",
  "description": "A set of Font, PDF, and SVG icons built by Living Design.",
  "repository": "https://gecgithub01.walmart.com/LivingDesign/icons.git",
  "author": "LivingDesignEngineer@email.wal-mart.com",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/font/*": "./dist/font/*",
    "./dist/keywords.json": "./dist/keywords.json"
  },
  "sideEffects": [
    "dist/font/*.css"
  ],
  "scripts": {
    "prebuild": "yarn clean",
    "build": "run-s build:svgo && run-p build:font build:keywords build:pdf build:react build:root && run-p rollup build:types",
    "postbuild": "find dist -type f -name *.tsx -delete",
    "build:font": "node scripts/build-font.mjs",
    "build:keywords": "node scripts/build-keywords.mjs",
    "build:pdf": "node scripts/build-pdf.mjs",
    "build:react": "node scripts/build-react.mjs",
    "build:root": "node scripts/build-root.mjs",
    "build:storybook": "NODE_ENV=production storybook build -o docs",
    "build:svgo": "svgo --config svgo.config.js -f icons/svg -o dist/svg",
    "build:types": "tsc --emitDeclarationOnly -p ./tsconfig.production.json",
    "clean": "rm -rf dist",
    "lint": "eslint --ext .js,.jsx,.mjs,.ts,.tsx .",
    "prepare": "yarn run prepare:husky && yarn run prepare:puppeteer",
    "prepare:husky": "husky install",
    "prepare:puppeteer": "node node_modules/puppeteer/install.js",
    "release": "standard-version",
    "rollup": "NODE_ENV=production rollup --config rollup.config.mjs",
    "prestart": "[ ! -d dist ] && yarn build || exit 0",
    "start": "storybook dev -p 8080",
    "test": "NODE_ENV=test jest",
    "test:watch": "yarn test --watch",
    "typecheck": "tsc --noEmit",
    "upload": "node scripts/upload-font.mjs"
  },
  "devDependencies": {
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-runtime": "^7.21.4",
    "@babel/plugin-transform-typescript": "^7.21.3",
    "@babel/preset-env": "^7.21.5",
    "@babel/preset-react": "^7.18.6",
    "@babel/runtime": "^7.15.0",
    "@commitlint/cli": "^17.6.3",
    "@commitlint/config-conventional": "^17.6.3",
    "@livingdesign/bogle": "^0.1.30",
    "@livingdesign/tokens": "^0.64.0",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-node-resolve": "^15.0.2",
    "@storybook/addon-docs": "^7.0.20",
    "@storybook/react-webpack5": "^7.0.20",
    "@svgr/core": "^8.0.0",
    "@svgr/plugin-jsx": "^8.0.1",
    "@svgr/plugin-svgo": "^8.0.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.1.5",
    "@types/classnames": "^2.3.1",
    "@types/jest": "^29.5.1",
    "@types/react": "^17.0.45",
    "@types/svg-parser": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "@walmart/pronto-js": "^4.2.0",
    "babel-jest": "^29.5.0",
    "babel-loader": "^9.1.2",
    "babel-plugin-typescript-to-proptypes": "^2.1.0",
    "chalk": "^5.2.0",
    "clean-css": "^5.3.2",
    "eslint": "^8.40.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fantasticon": "^2.0.0",
    "glob": "^10.2.2",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "lint-staged": "^13.2.2",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "puppeteer": "^19.7.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "rollup": "^3.21.5",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-rename-node-modules": "^1.3.1",
    "rollup-plugin-terser": "^7.0.2",
    "standard-version": "^9.5.0",
    "storybook": "^7.0.20",
    "svg-parser": "^2.0.4",
    "svgo": "^3.0.2",
    "typescript": "^5.0.4",
    "webpack-merge": "^5.8.0",
    "yargs": "^17.7.2"
  },
  "peerDependencies": {
    "@babel/runtime": "^7.15.0",
    "classnames": "^2.2.6",
    "prop-types": "^15.7.2",
    "react": "^16.14.0 || ^17 || ^18"
  }
}
