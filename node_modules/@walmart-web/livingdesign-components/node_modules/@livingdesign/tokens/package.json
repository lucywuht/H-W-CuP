{
  "name": "@livingdesign/tokens",
  "version": "0.59.3",
  "description": "Living Design System's design tokens.",
  "repository": "https://gecgithub01.walmart.com/LivingDesign/tokens",
  "license": "UNLICENSED",
  "author": "LivingDesignEngineer@email.wal-mart.com",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    "./dist/js/light/globals": {
      "require": "./dist/js/light/globals.js",
      "import": "./dist/js/light/globals.esm.js"
    },
    "./dist/js/light/components/*": {
      "require": "./dist/js/light/components/*.js",
      "import": "./dist/js/light/components/*.esm.js"
    },
    "./*": "./*"
  },
  "lint-staged": {
    "*.js": [
      "eslint . --fix"
    ]
  },
  "scripts": {
    "build": "style-dictionary build --config ./configuration",
    "clean": "rm -rf Sources/LivingDesignTokens/generated dist library/src/main/res",
    "commitlint": "commitlint --edit $1",
    "lint": "eslint .",
    "prepare": "husky install",
    "release": "standard-version",
    "test": "jest",
    "watch": "yarn run build && chokidar '{configuration,properties}/**/*.js' -c 'yarn run build'"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "chokidar-cli": "^3.0.0",
    "eslint": "^8.15.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "globby": "^11.0.1",
    "husky": "^8.0.1",
    "jest": "^28.1.0",
    "lint-staged": "^12.4.1",
    "lodash": "^4.17.21",
    "prettier": "^2.6.2",
    "standard-version": "^9.5.0",
    "style-dictionary": "^3.7.0",
    "tinycolor2": "^1.4.2"
  }
}
