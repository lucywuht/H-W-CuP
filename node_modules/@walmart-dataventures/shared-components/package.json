{
  "name": "@walmart-dataventures/shared-components",
  "version": "9.4.1",
  "description": "React component library used in Walmart Data Ventures",
  "repository": "https://gecgithub01.walmart.com/dsi-dataventures-luminate/ui-shared-components",
  "author": "",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "module": "dist/esm/src/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/index.js"
    },
    "./css": "./dist/index.css",
    "./icons": {
      "types": "./dist/types/icons.d.ts",
      "import": "./dist/esm/icons.js",
      "require": "./dist/icons.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/esm/testing/index.js",
      "require": "./dist/testing/index.js"
    },
    "./tokens": "./dist/tokens/index.scss",
    "./tokens/standalone": "./dist/tokens/standalone.scss",
    "./tokens/theme.css": "./dist/tokens/theme.css",
    "./tokens/*": "./dist/tokens/*.scss",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "icons.js"
  ],
  "scripts": {
    "clean": "rm -rf dist/ icons.js",
    "build": "npm run clean && npm run build-rollup",
    "build-rollup": "npm run build-types && BROWSERSLIST_IGNORE_OLD_DATA=1 rollup -c rollup.build.config.js --bundleConfigAsCjs",
    "build-types": "tsc -p tsconfig.json",
    "test:ci": "CI=true jest",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test-single": "jest -o -- src/__tests__/integration/Table.test.tsx",
    "prepare": "husky",
    "start": "npm run storybook-start",
    "storybook-start": "storybook dev -p 6006",
    "storybook-build": "npm run preBuild && STORYBOOK_DISABLE_TELEMETRY=true storybook build",
    "preBuild": "rm -rf storybook-static",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "lint:report": "eslint 'src/**/*.{ts,tsx}' --format unix | sort > eslint-report.txt",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,scss}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,scss}'",
    "tokens:update": "node scripts/dv-design-token-client.js --write",
    "tokens:preview": "node scripts/dv-design-token-client.js",
    "tokens:verify": "node scripts/dv-design-token-client.js --verify"
  },
  "devDependencies": {
    "@babel/core": "^7.22.17",
    "@babel/plugin-proposal-decorators": "^7.22.15",
    "@babel/preset-env": "^7.22.15",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.22.15",
    "@faker-js/faker": "^9.6.0",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/addon-docs": "9.1.20",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/react-webpack5": "9.1.20",
    "@testing-library/jest-dom": "~5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/body-scroll-lock": "^3.1.2",
    "@types/jest": "^29.5.5",
    "@types/jest-axe": "^3.5.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.2.7",
    "@types/react-transition-group": "^4.4.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@walmartlabs/jest-reporter-testburst": "^5.1.8",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-storybook": "9.1.20",
    "fs-extra": "^11.2.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^15.2.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^3.29.1",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.66.1",
    "sass-loader": "^13.3.2",
    "storybook": "9.1.20",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typed-scss-modules": "^7.1.4",
    "typescript": "^5.2.2",
    "webpack-merge": "^5.9.0"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17 || ^18",
    "react-dom": "^16.14.0 || ^17 || ^18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@livingdesign/everyday-sans": "^2.2.0",
    "@livingdesign/icons": "^1.8.1",
    "@livingdesign/tokens": "^0.66.0",
    "@tanstack/react-table": "^8.21.2",
    "@walmart-dataventures/chart-components": "1.1.0",
    "@walmart-web/livingdesign-components": "^1.0.38",
    "autoprefixer": "^10.4.15",
    "body-scroll-lock": "^4.0.0-beta.0",
    "classnames": "^2.3.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "i18next": "^25.3.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lodash": "^4.18.1",
    "react-dropzone": "^14.3.8",
    "react-focus-lock": "^2.9.5",
    "react-i18next": "^15.6.1",
    "react-transition-group": "^4.4.5"
  },
  "engines": {
    "node": "^22.17.1",
    "npm": "^10.9.2"
  },
  "lint-staged": {
    "src/**/*.{tsx,jsx}": [
      "node scripts/validateStorybookEntries.js src"
    ],
    "src/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "src/**/*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "sonar-report.xml",
    "indent": 4
  }
}
