{
  "name": "@livingdesign/tokens",
  "version": "0.74.0",
  "description": "Living Design System's design tokens.",
  "repository": "https://gecgithub01.walmart.com/LivingDesign/tokens",
  "license": "UNLICENSED",
  "author": "LivingDesignEngineer@email.wal-mart.com",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    "./dist/js/light/regular/globals": {
      "require": "./dist/js/light/regular/globals.js",
      "import": "./dist/js/light/regular/globals.esm.js"
    },
    "./dist/js/light/mega/globals": {
      "require": "./dist/js/light/mega/globals.js",
      "import": "./dist/js/light/mega/globals.esm.js"
    },
    "./dist/js/light/regular/components/*": {
      "require": "./dist/js/light/regular/components/*.js",
      "import": "./dist/js/light/regular/components/*.esm.js"
    },
    "./dist/js/light/mega/components/*": {
      "require": "./dist/js/light/mega/components/*.js",
      "import": "./dist/js/light/mega/components/*.esm.js"
    },
    "./*": "./*"
  },
  "lint-staged": {
    "*.js": [
      "eslint . --fix"
    ]
  },
  "scripts": {
    "build": "ts-node scripts/build",
    "clean": "rm -rf Sources/LivingDesignTokens/generated dist library/src/main/res",
    "commitlint": "commitlint --edit $1",
    "lint": "eslint .",
    "prepare": "husky install",
    "release": "semantic-release",
    "test": "jest",
    "typecheck": "tsc",
    "watch": "yarn run build && chokidar '{configuration,properties}/**/*.[jt]s' -c 'yarn run build'"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@babel/preset-typescript": "^7.21.4",
    "@commitlint/cli": "^17.5.1",
    "@commitlint/config-conventional": "^17.4.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.14.191",
    "@types/node": "^18.15.5",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "chokidar-cli": "^3.0.0",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-custom-rules": "file:custom-eslint-rules",
    "eslint-plugin-prettier": "^4.2.1",
    "globby": "^11.0.1",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "lint-staged": "^13.2.1",
    "lodash": "^4.17.21",
    "prettier": "^2.8.7",
    "semantic-release": "19.0.5",
    "style-dictionary": "^3.7.2",
    "tinycolor2": "^1.6.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  }
}
