{
  "name": "@walmart-dataventures/chart-components",
  "version": "1.1.0",
  "description": "React component library used in Walmart data ventures",
  "repository": "https://gecgithub01.walmart.com/dsi-dataventures-luminate/ui-charting-components",
  "author": "",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist/",
    "build": "npm run clean && npm run build-rollup",
    "build-rollup": "npm run build-types && BROWSERSLIST_IGNORE_OLD_DATA=1 rollup -c rollup.build.config.js --bundleConfigAsCjs",
    "build-types": "tsc -p tsconfig.json",
    "test": "jest",
    "test:coverage": "jest --coverage --u -0 --watch",
    "test-single": "jest -o -- src/__tests__/integration/Table.test.tsx",
    "husky-prepare": "husky install",
    "start": "npm run storybook-start",
    "storybook-start": "storybook dev -p 6006",
    "storybook-build": "npm run preBuild && STORYBOOK_DISABLE_TELEMETRY=true storybook build",
    "preBuild": "rm -rf storybook-static"
  },
  "devDependencies": {
    "@babel/core": "^7.22.17",
    "@babel/plugin-proposal-decorators": "^7.22.15",
    "@babel/plugin-transform-modules-commonjs": "^7.23.3",
    "@babel/preset-env": "^7.22.15",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.22.15",
    "@livingdesign/tokens": "^0.74.0",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@storybook/addon-a11y": "^7.4.5",
    "@storybook/addon-actions": "^7.4.5",
    "@storybook/addon-backgrounds": "^7.4.5",
    "@storybook/addon-controls": "^7.4.5",
    "@storybook/addon-docs": "^7.4.5",
    "@storybook/addon-essentials": "^7.4.5",
    "@storybook/addon-interactions": "^7.4.5",
    "@storybook/addon-knobs": "^7.0.2",
    "@storybook/addon-links": "^7.4.5",
    "@storybook/addon-onboarding": "^1.0.8",
    "@storybook/blocks": "^7.4.5",
    "@storybook/react": "^7.4.5",
    "@storybook/react-webpack5": "^7.4.5",
    "@storybook/testing-library": "^0.2.1",
    "@testing-library/jest-dom": "~5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.5",
    "@types/jest-axe": "^3.5.6",
    "@types/node": "^20.5.9",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "fs-extra": "^11.2.0",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^3.29.1",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.66.1",
    "sass-loader": "^13.3.2",
    "storybook": "^7.4.5",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typed-scss-modules": "^7.1.4",
    "typescript": "^5.2.2",
    "webpack-merge": "^5.9.0"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17 || ^18",
    "react-dom": "^16.14.0 || ^17 || ^18"
  },
  "transform": {
    "@amcharts[/\\\\].+\\.(js|jsx|ts|tsx)$": "<rootDir>/config/jest/babelTransformImportExport.js",
    "^.+\\.(js|jsx|ts|tsx)$": "babel-jest",
    "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
    "^(?!.*\\.(js|jsx|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
  },
  "transformIgnorePatterns": [
    "node_modules[/\\\\](?!@amcharts[/\\\\]amcharts4[/\\\\])",
    "^.+\\.module\\.(css|sass|scss)$"
  ],
  "dependencies": {
    "@amcharts/amcharts5": "^5.7.1",
    "@livingdesign/tokens": "^0.74.0",
    "@react-aria/ssr": "^3.8.0",
    "autoprefixer": "^10.4.15",
    "body-scroll-lock": "^4.0.0-beta.0",
    "classnames": "^2.3.2",
    "jest-canvas-mock": "^2.5.2",
    "react-focus-lock": "^2.9.5",
    "react-transition-group": "^4.4.5",
    "uuid": "^11.0.3"
  }
}
