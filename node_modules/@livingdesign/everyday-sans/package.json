{
  "name": "@livingdesign/everyday-sans",
  "version": "2.2.0",
  "description": "Walmart's brand font, packaged by Living Design",
  "repository": "https://gecgithub01.walmart.com/LivingDesign/everyday-sans.git",
  "author": "LivingDesignEngineer@email.wal-mart.com",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "run-p build:android build:webfonts",
    "build:android": "node scripts/build-android.mjs",
    "build:webfonts": "node scripts/build-webfonts.mjs",
    "build:storybook": "NODE_ENV=production storybook build -o docs/storybook",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint '{.storybook,scripts}/**/*'",
    "prepare": "husky install",
    "release": "semantic-release",
    "start": "storybook dev -p 6006"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@commitlint/cli": "^17.6.0",
    "@commitlint/config-conventional": "^17.6.0",
    "@eslint/compat": "^1.2.0",
    "@eslint/eslintrc": "^3.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-actions": "^7.0.20",
    "@storybook/addon-essentials": "^7.0.20",
    "@storybook/addon-links": "^7.0.20",
    "@storybook/react-webpack5": "^7.0.20",
    "babel-loader": "^9.1.2",
    "eslint": "^9.12.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "glob": "^10.0.0",
    "globals": "^15.11.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semantic-release": "^24.0.0",
    "storybook": "^7.0.20"
  },
  "overrides": {
    "eslint": "^9.12.0"
  }
}
