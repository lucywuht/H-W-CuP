{
  "name": "@livingdesign/icons",
  "version": "1.8.1",
  "description": "A set of Font, PDF, and SVG icons built by Living Design.",
  "repository": "https://gecgithub01.walmart.com/LivingDesign/icons.git",
  "author": "LivingDesignEngineer@email.wal-mart.com",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./mega": {
      "types": "./dist/mega/index.d.ts",
      "import": "./dist/mega/index.esm.js",
      "require": "./dist/mega/index.js"
    },
    "./dist/font/*": "./dist/font/*",
    "./dist/keywords.json": "./dist/keywords.json"
  },
  "typesVersions": {
    "*": {
      "mega": [
        "./dist/mega/index.d.ts"
      ]
    }
  },
  "sideEffects": [
    "dist/font/*.css",
    "dist/mega/font/*.css"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "run-s build:svgo && run-p build:font build:keywords build:pdf build:react build:root && run-s build:mega && run-p rollup build:types",
    "postbuild": "find dist -type f -name *.tsx -delete",
    "build:font": "node scripts/build-font.mjs",
    "build:keywords": "node scripts/build-keywords.mjs",
    "build:mega": "node scripts/build-mega.mjs",
    "build:pdf": "node scripts/build-pdf.mjs",
    "build:react": "node scripts/build-react.mjs",
    "build:root": "node scripts/build-root.mjs",
    "build:storybook": "NODE_ENV=production storybook build -o docs",
    "build:svgo": "svgo --config svgo.config.js -f icons/svg -o dist/svg",
    "build:types": "tsc --emitDeclarationOnly -p ./tsconfig.production.json",
    "build:vrt": "npm run clean && run-s build:svgo && run-p build:font build:keywords build:react build:root && run-s build:mega && run-p rollup build:types && find dist -type f -name *.tsx -delete",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "sync:airtable": "node scripts/sync-airtable.mjs",
    "sync:airtable:dry-run": "node scripts/sync-airtable.mjs --dry-run --verbose",
    "prepare": "npm run prepare:husky && npm run prepare:puppeteer",
    "prepare:husky": "husky",
    "prepare:puppeteer": "node node_modules/puppeteer/install.js",
    "release": "semantic-release",
    "rollup": "NODE_ENV=production rollup --config rollup.config.mjs",
    "prestart": "[ ! -d dist ] && npm run build || exit 0",
    "start": "storybook dev -p 8080",
    "test": "NODE_ENV=test jest",
    "test:watch": "npm run test --watch",
    "typecheck": "tsc --noEmit",
    "upload": "node scripts/upload-font.mjs",
    "vrt": "npm run build:vrt && npm run build:storybook && npx playwright test",
    "vrt:update": "npm run build:vrt && npm run build:storybook && npx playwright test --update-snapshots",
    "vrt-docker:create": "docker build -t ld-icons-vrt .",
    "vrt-docker:test": "sh scripts/vrt-docker-test.sh test",
    "vrt-docker:update": "sh scripts/vrt-docker-test.sh update"
  },
  "devDependencies": {
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/plugin-transform-typescript": "^7.26.3",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/runtime": "^7.26.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.15.0",
    "@livingdesign/bogle": "^0.1.33",
    "@livingdesign/tokens": "^1.0.0",
    "@playwright/test": "^1.52.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-docs": "^8.6.7",
    "@storybook/react-webpack5": "^8.6.7",
    "@svgr/core": "^8.0.0",
    "@svgr/plugin-jsx": "^8.0.1",
    "@svgr/plugin-svgo": "^8.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/classnames": "^2.3.1",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@types/svg-parser": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.18.1",
    "@walmart/pronto-js": "^4.2.0",
    "babel-jest": "^29.5.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-typescript-to-proptypes": "^2.1.0",
    "chalk": "^5.2.0",
    "clean-css": "^5.3.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.2.1",
    "fantasticon": "^3.0.0",
    "glob": "^11.0.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "lint-staged": "^15.2.11",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "puppeteer": "^19.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.28.1",
    "rollup-plugin-rename-node-modules": "^1.3.1",
    "semantic-release": "^24.2.0",
    "storybook": "^8.6.7",
    "svg-parser": "^2.0.4",
    "svgo": "^3.0.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "webpack-merge": "^6.0.1",
    "yargs": "^17.7.2"
  },
  "peerDependencies": {
    "@babel/runtime": "^7.15.0",
    "classnames": "^2.2.6",
    "prop-types": "^15.7.2",
    "react": "^16.14.0 || ^17 || ^18 || ^19"
  },
  "overrides": {
    "eslint": "^9.15.0",
    "rollup": "^4.28.1"
  }
}
